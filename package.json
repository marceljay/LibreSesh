{
  "name": "libresesh",
  "version": "0.4.0",
  "private": true,
  "description": "LibreSesh — a lightweight (un)conference scheduler",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:demo": "DEMO_MODE=1 npm run dev",
    "dev:kill": "tsx scripts/killDev.ts",
    "dev:fresh": "npm run dev:kill && npm run dev",
    "dev:demo:fresh": "npm run dev:kill && npm run dev:demo",
    "dev:api": "PORT=3001 tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node server/dist/index.js",
    "seed": "tsx scripts/seed.ts",
    "seed:long": "SEED_SLUG=longconf-2026 SEED_NAME='LongConf 2026' SEED_DAYS=14 tsx scripts/seed.ts",
    "rebuild:native": "node-gyp rebuild --release --directory=node_modules/better-sqlite3 --nodedir=\"$(node -p \"process.execPath.replace(/\\/bin\\/node$/, \\\"\\\")\")\"",
    "create-event": "tsx scripts/create-event.ts",
    "decrypt-backup": "tsx scripts/decrypt-backup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "browser-pass": "tsx scripts/browserPass.ts",
    "lint": "prettier --check . && eslint . && tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schema": "tsx scripts/schema.ts",
    "schema:pdf": "tsx scripts/schemaPdf.ts"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@floating-ui/react": "0.27.20",
    "@tailwindcss/vite": "4.3.3",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "lucide-react": "1.41.0",
    "marked": "^18.0.11",
    "qrcode-generator": "1.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "29.1.1",
    "mermaid": "11.17.2",
    "node-gyp": "12.4.0",
    "playwright-core": "1.63.0",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "supertest": "^7.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
