{
  "name": "libresesh",
  "version": "0.3.0",
  "private": true,
  "description": "LibreSesh — a lightweight (un)conference scheduler",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:demo": "DEMO_MODE=1 npm run dev",
    "dev:kill": "tsx scripts/killDev.ts",
    "dev:fresh": "npm run dev:kill && npm run dev",
    "dev:demo:fresh": "npm run dev:kill && npm run dev:demo",
    "dev:api": "PORT=3001 tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node server/dist/index.js",
    "seed": "tsx scripts/seed.ts",
    "seed:long": "SEED_SLUG=longconf-2026 SEED_NAME='LongConf 2026' SEED_DAYS=14 tsx scripts/seed.ts",
    "rebuild:native": "node-gyp rebuild --release --directory=node_modules/better-sqlite3 --nodedir=\"$(node -p \"process.execPath.replace(/\\/bin\\/node$/, \\\"\\\")\")\"",
    "create-event": "tsx scripts/create-event.ts",
    "decrypt-backup": "tsx scripts/decrypt-backup.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@floating-ui/react": "0.27.20",
    "@tailwindcss/vite": "4.3.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "lucide-react": "1.41.0",
    "marked": "^14.1.3",
    "qrcode-generator": "1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "node-gyp": "12.4.0",
    "postcss": "^8.4.49",
    "supertest": "^7.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
