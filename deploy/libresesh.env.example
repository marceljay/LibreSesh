# Copy to /etc/libresesh.env (systemd) or deploy/.env (compose), then edit.
# Never commit the filled-in version — .env* is gitignored.

NODE_ENV=production
PORT=3000
SERVE_STATIC=1

# Absolute path on the server. Its -wal and -shm sidecars sit alongside it.
DATABASE_PATH=/srv/libresesh/data/app.db

# Signs the identity cookie. Changing it signs everyone out and strands their
# display names — set once, keep forever. Keep this file off the disk that
# holds the database and its backups: the DB has the tokens, this signs them.
#   openssl rand -hex 32
COOKIE_SECRET=

# Gates event creation at /new.
INSTANCE_ADMIN_PASSWORD=

# Behind Caddy, so X-Forwarded-For is the real client IP for rate limiting.
TRUST_PROXY=1

# Compose only — the domain Caddy should serve and get a certificate for.
SITE_ADDRESS=https://schedule.example.org

# Public-demo instance: the gate becomes a role picker on the seeded demo
# events and no password is checked there — anyone can take any role, including
# organiser. Every other event on the instance keeps its passwords.
# DEMO_MODE=1

# Which slugs that applies to. Defaults to the two seeded fixtures.
# DEMO_EVENT_SLUGS=democonf-2026,longconf-2026

# Telegram announcements. Usually leave this unset: organisers paste their own
# bot token in Manage → Publish → Telegram, so their group gets a bot with
# their conference's name on it and you are not in the loop. Set it only to
# provide one bot for every event on a single-tenant instance; an event with
# its own token ignores it.
#
# @BotFather → /newbot → paste the token here. /revoke there if it leaks.
# One bot per instance — two processes on one token fight over getUpdates.
# TELEGRAM_BOT_TOKEN=

# Lets announcements link to sessions. Without it they go out without links.
# PUBLIC_URL=https://schedule.example.org
