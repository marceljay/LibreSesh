# --- Security ---
.env*
*.pem
*.key
.DS_Store
Thumbs.db

# Raw session transcripts — host-disk backup only, may contain tool output/secrets
_planning/transcripts-backup/


# Claude Code harness + dev container — local only, not shared/published
.claude/
.devcontainer/

# --- Node ---
node_modules/
dist/
build/
coverage/
.next/
.vercel/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Data ---
# The SQLite database and its WAL sidecars: attendee content and password hashes
data/
deploy/data/
*.db
*.db-wal
*.db-shm


# Working notes not meant for the repo — PR bodies, one-off reports.
_scratch/

# PR descriptions written by /pr when gh is unavailable
.temp/

# Dot-free copy of the build for the browser pass (a `.claude` path segment
# breaks static serving from a worktree)
lsbuild-scratch/

# Printed from docs/schema.md by `npm run schema:pdf`; regenerated, not tracked.
docs/schema.pdf
